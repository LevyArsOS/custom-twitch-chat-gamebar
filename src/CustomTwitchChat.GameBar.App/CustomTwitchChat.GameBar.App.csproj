<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <UseUwpTools>true</UseUwpTools>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="7.3.2607010" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CustomTwitchChat.GameBar.Core/CustomTwitchChat.GameBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="WebAssets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
